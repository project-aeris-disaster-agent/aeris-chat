# =====================================================================
# AERIS CHAT — LLM resolution order for POST /api/chat:
#   1. NVIDIA (if NVIDIA_API_KEY is set)               <-- preferred
#   2. HTTP LLM API (NEXT_PUBLIC_LLM_API_URL or LLM_HTTP_API_BASE_URL)
#   3. Legacy Flask backend (NEXT_PUBLIC_BACKEND_API_URL + LLM_API_KEY)
# =====================================================================

# --- NVIDIA LLM (preferred; powers /api/chat AND /api/llm/chat proxy) ---
NVIDIA_API_KEY=
LLM_MODEL=moonshotai/kimi-k2.6
# Optional sampling controls applied to NVIDIA + HTTP LLM calls
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT_MS=45000
# Optional system prompt prepended on every /api/chat call when none provided
# LLM_SYSTEM_PROMPT=
# Optional: require Authorization: Bearer {LLM_API_KEY} on /api/llm/chat
# (Used by AERIS DASHBOARD when calling this app as its agent backend.)
LLM_API_KEY=

# --- HTTP LLM API (fallback only if NVIDIA_API_KEY is unset) ---
# Development: use localhost when backend runs on same machine.
# Production: use your active tunnel or deployed backend URL.
# NEXT_PUBLIC_LLM_API_URL=http://localhost:3005
# Optional client-visible key (prefer server-only below for secrets)
# NEXT_PUBLIC_LLM_API_KEY=

# Optional: override public URL for server-side chat only (otherwise NEXT_PUBLIC_LLM_API_URL is used)
# LLM_HTTP_API_BASE_URL=https://your-backend.example.com
# LLM_HTTP_API_KEY=

# --- Legacy Flask backend (only if no NVIDIA key and no HTTP LLM URL above) ---
# NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# --- Shared Supabase disaster reports (same project as AERIS DASHBOARD) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Real-time AI triage hand-off to AERIS DASHBOARD ---
# When set, POST /api/reports notifies the dashboard immediately after a new
# report is created so urgent incidents are classified within seconds rather
# than waiting for the daily cron.
AERIS_DASHBOARD_API_BASE_URL=
# Shared secret that authorizes POST /api/internal/triage on the dashboard.
# Generate with: openssl rand -hex 32
INTERNAL_TRIAGE_SECRET=
# Timeout for the fire-and-forget triage notification (ms). Default 8000.
# AERIS_TRIAGE_TIMEOUT_MS=8000

# --- Smoke tests ---
# Used by `npm run smoke:llm` to point at a deployed instance.
# LLM_TEST_BASE_URL=https://aeris-chat.example.com
# LLM_TEST_TIMEOUT_MS=30000