# --- HTTP LLM API (tunnel or deployed) — used by /api/chat and /test-connection ---
# Development: use localhost when backend runs on same machine.
# Production: use your active tunnel or deployed backend URL.
NEXT_PUBLIC_LLM_API_URL=http://localhost:3005
# Optional client-visible key (prefer server-only below for secrets)
NEXT_PUBLIC_LLM_API_KEY=

# Optional: override public URL for server-side chat only (otherwise NEXT_PUBLIC_LLM_API_URL is used)
# LLM_HTTP_API_BASE_URL=https://your-backend.example.com
# LLM_HTTP_API_KEY=

# Optional body defaults for POST /api/chat
# LLM_SYSTEM_PROMPT=
# LLM_TEMPERATURE=0.7

# --- Legacy Flask backend (only if no LLM HTTP URL above) ---
# NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
# LLM_API_KEY=