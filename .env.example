# =====================================================================
# AERIS CHAT - NVIDIA-only LLM. Powers both:
#   - POST /api/chat        (citizen chatbot, Supabase-backed sessions)
#   - POST /api/llm/chat    (frozen agent contract - see docs/AGENT_CONTRACT.md)
# =====================================================================

# --- NVIDIA LLM (required) ---
NVIDIA_API_KEY=
# Recommended after benchmark (scripts/benchmark-nvidia-models.mjs):
#   meta/llama-4-maverick-17b-instruct  — fast + strong templates (default)
# Alternatives: meta/llama-3.3-70b-instruct, mistralai/mistral-medium-3.5-128b
LLM_MODEL=meta/llama-4-maverick-17b-128e-instruct
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=55000
# LLM_TEMPERATURE=0.7
# Optional system prompt for /api/chat. When set, this OVERRIDES the built-in
# AERIS character-card persona (compiled from character/aeris.character.json
# via lib/character/aeris-character.ts). Leave unset to use the character card.
# LLM_SYSTEM_PROMPT=

# --- Bearer auth for /api/llm/chat ---
# When set, AERIS DASHBOARD (and any other agent client) MUST send
# `Authorization: Bearer <LLM_API_KEY>`. The dashboard reads this same value
# as AERIS_CHAT_API_KEY. Both projects MUST hold the identical secret.
LLM_API_KEY=

# --- Shared Supabase disaster reports (same project as AERIS DASHBOARD) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Real-time AI triage hand-off to AERIS DASHBOARD ---
AERIS_DASHBOARD_API_BASE_URL=
INTERNAL_TRIAGE_SECRET=
# AERIS_TRIAGE_TIMEOUT_MS=8000

# --- Smoke / benchmark ---
# npm run smoke:llm
# npm run benchmark:models
# LLM_TEST_BASE_URL=http://localhost:3001
# LLM_TEST_TIMEOUT_MS=60000
