# =====================================================================
# AERIS CHAT - NVIDIA-only LLM. Powers both:
#   - POST /api/chat        (citizen chatbot, Supabase-backed sessions)
#   - POST /api/llm/chat    (frozen agent contract - see docs/AGENT_CONTRACT.md)
# =====================================================================

# --- NVIDIA LLM (required) ---
NVIDIA_API_KEY=
# Recommended after benchmark (scripts/benchmark-nvidia-models.mjs):
#   meta/llama-4-maverick-17b-instruct  — fast + strong templates (default)
# Alternatives: meta/llama-3.3-70b-instruct, mistralai/mistral-medium-3.5-128b
LLM_MODEL=meta/llama-4-maverick-17b-128e-instruct
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_MS=55000
# LLM_TEMPERATURE=0.7
# Optional system prompt for /api/chat. When set, this OVERRIDES the built-in
# AERIS character-card persona (compiled from character/aeris.character.json
# via lib/character/aeris-character.ts). Leave unset to use the character card.
# LLM_SYSTEM_PROMPT=

# --- Bearer auth for /api/llm/chat ---
# When set, AERIS DASHBOARD (and any other agent client) MUST send
# `Authorization: Bearer <LLM_API_KEY>`. The dashboard reads this same value
# as AERIS_CHAT_API_KEY. Both projects MUST hold the identical secret.
# REQUIRED in production: when NODE_ENV=production and this is unset, the
# /api/llm/chat proxy fails CLOSED (returns 401) to avoid an open LLM proxy.
LLM_API_KEY=

# --- Guardrails: rate limiting (Upstash Redis) ---
# Used by lib/guardrails/rate-limit.ts to throttle LLM-touching API routes and
# protect against abuse / cost-based DoS. When BOTH are set, rate limiting is
# enforced. When unset, the limiter fails OPEN (allows traffic) so local dev
# keeps working — set these in any shared/production environment.
# Create a database at https://console.upstash.com/redis and copy the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional overrides (defaults shown):
# RATE_LIMIT_CHAT_MAX=20          # requests per window per identity
# RATE_LIMIT_CHAT_WINDOW_S=60     # window length in seconds
# RATE_LIMIT_IP_MAX=60            # coarse per-IP requests per window (middleware)
# RATE_LIMIT_IP_WINDOW_S=60

# --- Guardrails: input limits & content moderation ---
# MAX_MESSAGE_CHARS=4000          # per-message content cap (413 when exceeded)
# MAX_MESSAGES_PER_REQUEST=20     # max messages accepted per chat request
# Optional external moderation hook. When MODERATION_API_URL is set, the
# in-repo deny-list is augmented by an external OpenAI-compatible moderation
# endpoint. Leave unset to use only the built-in deny-list.
# MODERATION_API_URL=
# MODERATION_API_KEY=

# --- Shared Supabase disaster reports (same project as AERIS DASHBOARD) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Real-time AI triage hand-off to AERIS DASHBOARD ---
AERIS_DASHBOARD_API_BASE_URL=
INTERNAL_TRIAGE_SECRET=
# AERIS_TRIAGE_TIMEOUT_MS=8000

# --- Weather intelligence (citizen chat) ---
# Optional: enriches lookup_typhoon_signal with live PAGASA TCWS data
# WEATHER_PREFETCH_DAYS=2
# WEATHER_TOOL_LOOP_MAX_STEPS=2

# --- Smoke / benchmark ---
# npm run smoke:llm
# npm run benchmark:models
# LLM_TEST_BASE_URL=http://localhost:3001
# LLM_TEST_TIMEOUT_MS=60000
